"""Download a small hourly ERCOT electricity-demand sample from the EIA API."""

from pathlib import Path
import json
import os

import pandas as pd
import requests
from dotenv import load_dotenv


PROJECT_ROOT = Path(__file__).resolve().parents[1]
RAW_DIR = PROJECT_ROOT / "data" / "raw"
PROCESSED_DIR = PROJECT_ROOT / "data" / "processed"
API_URL = "https://api.eia.gov/v2/electricity/rto/region-data/data/"


def get_eia_demand(respondent_code: str, api_key: str) -> pd.DataFrame:
    """Fetch one week of hourly observations for the requested respondent."""
    params = {
        "api_key": api_key,
        "frequency": "hourly",
        "data[0]": "value",
        "facets[respondent][]": respondent_code,
        "facets[type][]": "D",
        "start": "2024-01-01T00",
        "end": "2024-01-07T23",
        "sort[0][column]": "period",
        "sort[0][direction]": "asc",
        "offset": 0,
        "length": 168,
    }

    try:
        response = requests.get(API_URL, params=params, timeout=30)
        response.raise_for_status()
    except requests.RequestException as exc:
        raise RuntimeError("The EIA request failed. Check your network connection and API key.") from None
    payload = response.json()
    rows = payload.get("response", {}).get("data", [])
    if not rows:
        raise RuntimeError("The EIA API returned no demand rows for the test window.")

    RAW_DIR.mkdir(parents=True, exist_ok=True)
    PROCESSED_DIR.mkdir(parents=True, exist_ok=True)
    (RAW_DIR / "ercot_demand_sample.json").write_text(
        json.dumps(payload, indent=2), encoding="utf-8"
    )

    df = pd.DataFrame(rows)
    df["period"] = pd.to_datetime(df["period"])
    df["value"] = pd.to_numeric(df["value"])
    return df


def main() -> None:
    """Load the API key and fetch the ERCOT weekly demand file."""
    MARKETS = {
        "ERCO": "ERCOT",
        "PJM": "PJM",
        "CISO": "CAISO",
        "MISO": "MISO",
        "SWPP": "SPP",
    }

    load_dotenv(PROJECT_ROOT / ".env")
    api_key = os.getenv("EIA_API_KEY")
    if not api_key or api_key == "your_eia_api_key_here":
        raise RuntimeError(
            "Missing EIA_API_KEY. Copy .env.example to .env and add your key locally."
        )

    market_data = []
    for respondent_code, market_name in MARKETS.items():
        df = get_eia_demand(respondent_code, api_key)
        df["market"] = market_name
        market_data.append(df)

    combined_data = pd.concat(market_data, ignore_index=True)
    output_path = PROCESSED_DIR / "hourly_demand_sample.csv"
    combined_data.to_csv(output_path, index=False)
    print(f"Saved {len(combined_data)} observations to {output_path}")


if __name__ == "__main__":
    main()
